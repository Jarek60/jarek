"4"
arr = np.array([
[2, 3, 5],
[14, 6, 8],
[11, 13, 17],
[7, 10, 13]
])

def rows_with_primes(arr):
    def is_prime(n):
        if n < 2:
            return False
        for i in range(2, int(np.sqrt(n)) + 1):
            if n % i == 0:
                return False
        return True

    is_prime_vec = np.vectorize(is_prime)
    mask = np.any(is_prime_vec(arr), axis=1)
    return arr[mask]
print(rows_with_primes(arr))



"5"
def checkerboard():
    board = np.zeros((8, 8), dtype=int)
    board[::2, ::2] = 1  # even rows, even columns
    board[1::2, 1::2] = 1  # odd rows, odd columns
    return board
print(checkerboard())


def reverse_checkerboard():
    board = np.zeros((8, 8), dtype=int)
    board[1::2, ::2] = 1  # even rows, even columns
    board[::2, 1::2] = 1 # odd rows, odd columns
    return board
print(reverse_checkerboard())



